FROM python:3.12-slim

# Desativa buffer para logs em tempo real e impede gravacao de .pyc
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

# Instala dependencias de compilacao, certificados SSL e curl para healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Instala dependencias Python
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Porta oficial da API FastAPI do Brilha+
EXPOSE 8080

# Inicializacao com Hot-Reload ativo
CMD ["uvicorn", "backend_python.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]
