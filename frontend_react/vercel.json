{
  "functions": {
    "api/index.py": {
      "excludeFiles": "{node_modules,src,dist}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
