# =====================================================================
# DATAINGEST (PYTHON / FASTAPI / POLARS ETL ENGINE)
# =====================================================================

# --- DATABRICKS SQL WAREHOUSE (ORIGEM DATA LAKE) ---
DATABRICKS_SERVER_HOSTNAME=sua-instancia.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/seu_warehouse_id
DATABRICKS_ACCESS_TOKEN=dapi_seu_token_databricks_aqui
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=default

# --- POSTGRESQL (BANCO DESTINO / SUPABASE) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brilha_mais_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_postgres_aqui
POSTGRES_SCHEMA=public

# --- CONFIGURAÇÕES DE PROCESSAMENTO ---
BATCH_SIZE=10000
SCHEDULE_TIME=06:00
LOG_LEVEL=INFO
