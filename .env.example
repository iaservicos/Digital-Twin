# =====================================================================
# CONFIGURAÇÃO GERAL DO ECOSSISTEMA BRILHA+ (ROOT / DOCKER COMPOSE)
# =====================================================================

# --- POSTGRESQL (BANCO CENTRAL / SUPABASE) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/brilha_mais_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=sua_senha_postgres_aqui

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=brilha_mais_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_postgres_aqui
POSTGRES_SCHEMA=public

# --- DATABRICKS (DATA LAKE SQL WAREHOUSE) ---
DATABRICKS_SERVER_HOSTNAME=sua-instancia.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/seu_warehouse_id
DATABRICKS_ACCESS_TOKEN=dapi_seu_token_databricks_aqui
DATABRICKS_CATALOG=hive_metastore
DATABRICKS_SCHEMA=default

# --- FLYWAY DATABASE MIGRATION ---
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=false
SPRING_FLYWAY_IGNORE_MIGRATION_PATTERNS=*:*

# --- SEGURANÇA E AUTENTICAÇÃO (JWT) ---
JWT_SECRET=sua_chave_secreta_jwt_min_256_bits_aqui
ADMIN_MATRICULA=ADMIN
ADMIN_PASSWORD=senha_admin_padrao

# --- FRONTEND E APIs ---
VITE_API_URL=http://localhost:8080
VITE_BACKEND_API_URL=http://localhost:8080
VITE_PYTHON_API_URL=http://localhost:8001

# --- PIPELINE E AGENDAMENTO (DATAINGEST) ---
BATCH_SIZE=10000
SCHEDULE_TIME=06:00
LOG_LEVEL=INFO
